{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/domain/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/footlink-scout/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow))/i]",
        "message": "Font not provided by the design system. Available: Barlow."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|onMenuClick|menuDot|searchPlaceholder|searchValue|onSearchChange|searchSlot|left|center|actions|user|style|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: logoSrc, onMenuClick, menuDot, searchPlaceholder, searchValue, onSearchChange, searchSlot, left, center, actions, user, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AthleteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:nickname|fullName|avatar|shield|nationality|meta|rating|variant|action|showColorDot|onDelete|style|key|ref|className|style|children)$/]",
        "message": "<AthleteCard> doesn't accept that prop. Declared props: nickname, fullName, avatar, shield, nationality, meta, rating, variant, action, showColorDot, onDelete, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AthleteCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gray|yellow|green|blue|red)$/]",
        "message": "<AthleteCard> variant must be one of 'gray' | 'yellow' | 'green' | 'blue' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|shield|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, shield, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:purple|brazil|latam|global|fifa|active|inactive|pending|info)$/]",
        "message": "<Badge> tone must be one of 'purple' | 'brazil' | 'latam' | 'global' | 'fifa' | 'active' | 'inactive' | 'pending' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|rounded|fluid|outline|smaller|noShadow|disabled|iconLeft|iconRight|children|style|onClick|type|title|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: color, rounded, fluid, outline, smaller, noShadow, disabled, iconLeft, iconRight, children, style, onClick, type, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:default|green|purple|danger|orange|white|secondary|transparent|link)$/]",
        "message": "<Button> color must be one of 'default' | 'green' | 'purple' | 'danger' | 'orange' | 'white' | 'secondary' | 'transparent' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|title|footer|children|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, title, footer, children, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|softShadow|borderedGrey|profile)$/]",
        "message": "<Card> variant must be one of 'default' | 'softShadow' | 'borderedGrey' | 'profile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|sender|text|time|avatar|shield|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: type, sender, text, time, avatar, shield, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:sent|received)$/]",
        "message": "<ChatMessage> type must be one of 'sent' | 'received'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|onClose|tone|width|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, footer, onClose, tone, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|destructive)$/]",
        "message": "<Dialog> tone must be one of 'default' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, description, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Flag'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|src|name|size|style|key|ref|className|style|children)$/]",
        "message": "<Flag> doesn't accept that prop. Declared props: code, src, name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Flag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg|topbar|xl)$/]",
        "message": "<Flag> size must be one of 'xs' | 'sm' | 'md' | 'lg' | 'topbar' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|type|label|iconLeft|iconRight|hasError|helper|smaller|rounded|darkMode|disabled|style|wrapperStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, type, label, iconLeft, iconRight, hasError, helper, smaller, rounded, darkMode, disabled, style, wrapperStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='KanbanColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|children|onAddAthlete|onMenu|style|key|ref|className|style|children)$/]",
        "message": "<KanbanColumn> doesn't accept that prop. Declared props: title, count, children, onAddAthlete, onMenu, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonitoringButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:monitoring|size|loading|onToggle|onOpenLists|style|key|ref|className|style|children)$/]",
        "message": "<MonitoringButton> doesn't accept that prop. Declared props: monitoring, size, loading, onToggle, onOpenLists, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonitoringButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<MonitoringButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavDrawerItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|color|onClick|key|ref|className|style|children)$/]",
        "message": "<NavDrawerItem> doesn't accept that prop. Declared props: label, icon, color, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|pages|onChange|perPage|perPageOptions|onPerPageChange|style|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: page, pages, onChange, perPage, perPageOptions, onPerPageChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedToggle> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|options|placeholder|label|disabled|style|wrapperStyle|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: value, onChange, options, placeholder, label, disabled, style, wrapperStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:in_progress|completed|not_started|active|inactive|pending)$/]",
        "message": "<StatusPill> status must be one of 'in_progress' | 'completed' | 'not_started' | 'active' | 'inactive' | 'pending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|width|sortable|key|ref|className|style|children)$/]",
        "message": "<TableColumn> doesn't accept that prop. Declared props: key, label, align, width, sortable."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<TableColumn> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|size|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, onChange, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:page|compact)$/]",
        "message": "<Tabs> size must be one of 'page' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|position|children|style|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, position, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:bottom|top|left|right)$/]",
        "message": "<Tooltip> position must be one of 'bottom' | 'top' | 'left' | 'right'."
      }
    ]
  },
